# Copy to .env.local (git-ignored). Vite only exposes VITE_-prefixed vars
# to the browser. LLM and PRISM keys must stay server-side.

# --- optional client (graph works from CSVs without these) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- /api/investigate (set at least one LLM key) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=openai/gpt-oss-20b

# --- PRISM (Block Convey) — POST after each agent reply ---
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=
